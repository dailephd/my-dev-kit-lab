{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dailephd/my-dev-kit/main/contracts/ecosystem/v1/compatibility-bundle-v1.schema.json",
  "title": "CompatibilityBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "status",
    "components",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "supported",
        "tested",
        "certified",
        "active"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageName",
          "packageVersion"
        ],
        "properties": {
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "schemaVersion"
        ],
        "properties": {
          "contractId": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "testEvidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "certificationProfile": {
      "type": "string",
      "minLength": 1
    },
    "supersedesBundleId": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "certified",
              "active"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "testEvidenceRefs",
          "certificationProfile"
        ],
        "properties": {
          "testEvidenceRefs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
