{
  "schemaVersion": "1.0.0",
  "id": "lab-browser-fixture",
  "title": "Lab browser fixture tutorial",
  "description": "A generic, lab-owned tutorial that exercises every action, locator, assertion and visual declaration against a local static fixture app.",
  "targetId": "lab-browser-fixture",
  "browser": {
    "viewport": { "width": 1024, "height": 768 }
  },
  "steps": [
    {
      "id": "open-app",
      "narration": "Open the fixture application in the browser.",
      "action": { "type": "goto", "path": "/", "waitUntil": "load" },
      "highlight": { "kind": "css", "selector": "#page-title" },
      "callout": { "text": "This is the fixture application.", "locator": { "kind": "css", "selector": "#page-title" }, "placement": "bottom" },
      "screenshot": { "id": "app-open" },
      "assertions": [
        { "type": "url-path-equals", "expected": "/" },
        { "type": "element-visible", "locator": { "kind": "role", "role": "heading", "name": "Tutorial Fixture" } },
        { "type": "text-equals", "locator": { "kind": "css", "selector": "#page-title" }, "expected": "Tutorial Fixture" },
        { "type": "file-exists", "path": "out/report.json" },
        { "type": "json-file-equals", "path": "out/report.json", "pointer": "/counts/widgets", "expected": 3 },
        { "type": "http-json-equals", "path": "/api/status", "pointer": "/ok", "expected": true }
      ]
    },
    {
      "id": "activate",
      "narration": "Click the primary action button to activate the panel.",
      "action": { "type": "click", "locator": { "kind": "test-id", "testId": "primary-action" } },
      "highlight": { "kind": "test-id", "testId": "primary-action" },
      "callout": { "text": "Clicking here activates the panel.", "placement": "auto", "locator": { "kind": "test-id", "testId": "primary-action" } },
      "screenshot": { "id": "activated" },
      "assertions": [
        { "type": "text-equals", "locator": { "kind": "test-id", "testId": "activation-count" }, "expected": "1" },
        { "type": "attribute-equals", "locator": { "kind": "test-id", "testId": "primary-action" }, "name": "data-state", "expected": "activated" }
      ]
    },
    {
      "id": "fill-name",
      "narration": "Type a name into the form field.",
      "action": { "type": "fill", "locator": { "kind": "test-id", "testId": "name-field" }, "value": "Ada" },
      "assertions": [
        { "type": "text-contains", "locator": { "kind": "test-id", "testId": "greeting" }, "expected": "Hello, Ada" }
      ]
    },
    {
      "id": "submit-name",
      "narration": "Press Enter to submit the name.",
      "action": { "type": "press", "locator": { "kind": "test-id", "testId": "name-field" }, "key": "Enter" },
      "screenshot": { "id": "submitted" },
      "assertions": [
        { "type": "text-contains", "locator": { "kind": "test-id", "testId": "greeting" }, "expected": "Submitted: Ada" }
      ]
    },
    {
      "id": "hover-button",
      "narration": "Hover the secondary button to reveal its state.",
      "action": { "type": "hover", "locator": { "kind": "test-id", "testId": "hover-target" } },
      "assertions": [
        { "type": "text-equals", "locator": { "kind": "test-id", "testId": "hover-readout" }, "expected": "hovered" }
      ]
    },
    {
      "id": "drag-card",
      "narration": "Drag the card onto the drop target.",
      "action": {
        "type": "drag",
        "source": { "kind": "test-id", "testId": "drag-card" },
        "target": { "kind": "test-id", "testId": "drop-zone" }
      },
      "highlight": { "kind": "test-id", "testId": "drop-zone" },
      "screenshot": { "id": "dropped" },
      "assertions": [
        { "type": "attribute-equals", "locator": { "kind": "test-id", "testId": "drop-zone" }, "name": "data-dropped", "expected": "true" }
      ]
    },
    {
      "id": "wait-banner",
      "narration": "Wait for the delayed status banner to appear.",
      "action": {
        "type": "wait-for",
        "locator": { "kind": "text", "text": "Delayed banner is now visible" },
        "state": "visible",
        "timeoutMs": 5000
      },
      "callout": { "text": "The banner appears after a short delay." },
      "screenshot": { "id": "banner-visible" },
      "assertions": [
        { "type": "element-visible", "locator": { "kind": "test-id", "testId": "status-banner" } }
      ]
    }
  ]
}
